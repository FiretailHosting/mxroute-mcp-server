# Production environment variables
MX_HOST=host.mxrouting.net
MX_PORT=2000
MX_USER=your_mxroute_username
MX_KEY=your_mxroute_api_key
MCP_SECRET=your_secure_random_secret_here
PORT=3000
NODE_ENV=production
# Bind address (use 0.0.0.0 to listen on all interfaces in containers)
# HOST=0.0.0.0
# Request logging (set to 'debug' to enable request logging)
# LOG_LEVEL=debug